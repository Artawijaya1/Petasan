# ============================================================
# Bob Inference API Configuration
# ============================================================
# Buat Inference API key di: https://bob.ibm.com
# Pilih scope "Inference" saat membuat key.
# Salin nilai key dan simpan di sini.

BOB_API_KEY=bob_prod
# Base URL endpoint Bob (OpenAI-compatible LiteLLM proxy)
BOB_BASE_URL=https://bob.ibm.com/api

# Nama model yang dipanggil (default: "bob")
BOB_MODEL=bob
